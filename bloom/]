#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <unistd.h>

#define HEIGHT 	10
#define WIDTH 	10

typedef struct Corpse {
int 	x, y;

struct 	Corpse *forward;
struct 	Corpse *backward;
} Corpse;

typedef struct {
int 	size;

Corpse 	*head;
Corpse 	*tail;
} Snake;

typedef struct {
int 	pos : 2;
} bitmap;

void create_fruits(bitmap *map);
void init_snake(Snake *snk);
void add_corpse(Snake *snk);
void add_snake_head(Snake *snk, Corpse *nhead);
void remove_snake_tail(Snake *snk);

void kill_all(Snake *snk);
void init_stage();
void win(time_t *start);
void manage_map(bitmap *map, Snake *snk);
void move_snake(int dx, int dy, Snake *snk);
void render(bitmap *map);

int limit(int x, int y);

int END = 0;


int main(int argc, char *argv[])
{
	time_t start = clock();

	Snake *snk = (Snake *) malloc(sizeof(Snake));
	init_snake(snk);
	init_stage();

	bitmap *map = (bitmap *) calloc(HEIGHT * WIDTH, sizeof(bitmap));

	while (!END)
	{
		move_snake(1, 0, snk);
		manage_map(map, snk);

		render(map);
		sleep(0.5);

		if (snk->size == (HEIGHT * WIDTH) - 1)
		{
			win(&start);
		}
	}


	kill_all(snk);
	free(map);	
	return 0;
}

void init_snake(Snake *snk)
{
	snk->size = 1;
	snk->head = (Corpse *) malloc(sizeof(Corpse));

	snk->head->x = 0;
	snk->head->y = 0;	
	snk->head->forward 	= NULL;
	snk->head->backward 	= NULL;

	snk->tail = NULL;
}

void add_corpse(Snake *snk)
{
	Corpse *new = (Corpse *) malloc(sizeof(Corpse));
	if (new == NULL)
		return ;

	snk->size++;
	if (snk->size == 2)
	{
		snk->tail = new;
		snk->tail->forward = NULL;
		snk->tail->backward = snk->head;

		snk->head->forward = new;
		return ;
	}

	snk->tail->forward = new;
	new->backward = snk->tail;

	snk->tail = new;
	snk->tail->forward = NULL;

	return ;
}

void kill_all(Snake *snk)
{
	Corpse *temp = snk->head;
	while (snk->head->forward != NULL)
	{
		snk->head = snk->head->forward;
		free(temp);
		temp = snk->head;
	}

	free(snk);
	return;
}

void init_stage()
{
	// Prepares terminal for the game
	system("clear");

	for (int i = 0; i < HEIGHT; i++)
	{
		for (int k = 0; k < WIDTH; k++)
		{
			printf("#");
			fflush(NULL);
			sleep(3.0 - (float)(k * (i + 1) * 0.0001));
		}
		printf("\n");
	}
	// missing clear up
	return ;
}


void win(time_t *start)
{

	printf("FInal time: %f\n", (float)(clock() - *start) / CLOCKS_PER_SEC);
}

void create_fruit(bitmap *map)
{
	int fpos = rand() % ((HEIGHT * WIDTH) + 1);
	
	while (map[fpos].pos)
	{
		fpos = rand() % ((HEIGHT * WIDTH) + 1);	
	}
	map[fpos].pos = 1;
	return ;
}

void manage_map(bitmap *map, Snake *snk)
{
	int spos = (snk->head->y * WIDTH) + snk->head->x;
	int tpos = (snk->tail->y * WIDTH) + snk->tail->x;

	if (limit(snk->head->x, snk->head->y))
	{
		END = 1;
	}

	if (map[spos].pos)
	{
		if (map[spos].pos == 1)
		{	
			add_corpse(snk);
			return ;
		}
		else 
		{
			END = 1;
			return ;
		}
	}
	map[spos].pos = 2;
	map[tpos].pos = 0;

	return ;
}

int limit(int x, int y)
{
	if (x < 0 || x > (WIDTH - 1))
		return 1;

	if (y < 0 || y > (HEIGHT - 1))
		return 1;

	return 0;
}

void move_snake(int dx, int dy, Snake *snk)
{
	Corpse *nhead = (Corpse *) malloc(sizeof(Corpse));
	nhead->x = snk->head->x + dx;
	nhead->y = snk->head->y + dy;

	add_snake_head(snk, nhead);
	remove_snake_tail(snk);

	return ;
}

void add_snake_head(Snake *snk, Corpse *nhead)
{
	snk->head->forward = nhead;
	nhead->backward = snk->head;

	snk->head = nhead;
	return ;
}

void remove_snake_tail(Snake *snk)
{
	snk->tail->backward->forward = NULL;
	
	Corpse *temp = snk->tail;
	snk->tail = snk->tail->backward;

	free(temp);
	return ;
}

void render(bitmap *map)
{
	for (int i = 0; i < WIDTH; i++)
	{
		printf("-");
	}
}
